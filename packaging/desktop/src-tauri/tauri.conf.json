{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KohakuTerrarium",
  "version": "0.0.0",
  "identifier": "com.kohaku.terrarium",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "Universal agent framework desktop app",
    "targets": ["msi", "nsis", "dmg", "app"],
    "icon": [
      "../../../src/kohakuterrarium/app_icon.png",
      "../../../src/kohakuterrarium/app_icon.icns",
      "../../../src/kohakuterrarium/app_icon.ico"
    ],
    "resources": {
      "../stage/python": "python",
      "../stage/bootstrap": "bootstrap",
      "../stage/bundled-release": "bundled-release"
    },
    "fileAssociations": [
      {
        "ext": ["kohakutr"],
        "name": "KohakuTerrarium session",
        "description": "KohakuTerrarium session file",
        "mimeType": "application/vnd.kohakuterrarium.session",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis-hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGNDdEOUQyQjc4RkE4RjEKUldUeHFJKzMwdGxIajM4dzE1d2IxUHlzTkdWUjZ2bGwvUEpXeEd4dFUzc1Y5d2ZvbVpiT0N0SVMK",
      "endpoints": [
        "https://github.com/Kohaku-Lab/KohakuTerrarium/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["kt"]
      }
    }
  }
}
