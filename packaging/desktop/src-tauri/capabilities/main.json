{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Native calls the loading shell and the app page may make.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:event:default",
    "allow-get-desktop-capabilities",
    "allow-request-desktop-attention",
    "allow-open-external",
    "allow-show-notification",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-set-desktop-theme",
    "allow-take-deep-link",
    "allow-smoke-ack",
    "allow-check-shell-update",
    "allow-install-shell-update",
    "allow-open-overlay-window",
    "allow-close-overlay-window",
    "allow-get-close-to-tray",
    "allow-set-close-to-tray",
    "allow-set-attention-state",
    "allow-set-tray-items",
    "allow-set-tray-sessions",
    "allow-get-summon-shortcut",
    "allow-set-summon-shortcut",
    "allow-take-pending-opens",
    "allow-open-popout-window",
    "allow-set-window-chrome",
    "allow-set-keep-awake",
    "allow-add-recent-session",
    "allow-get-explorer-verbs",
    "allow-set-explorer-verbs",
    "allow-get-backend-status",
    "allow-restart-backend",
    "allow-open-logs",
    "allow-repair-runtime",
    "allow-export-diagnostics",
    "allow-pick-folder",
    "allow-pick-files",
    "allow-save-file",
    "allow-get-shell-settings",
    "allow-patch-shell-settings"
  ]
}
